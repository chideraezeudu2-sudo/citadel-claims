# Environment variables for Citadel Claims Backend
# Copy this file to .env and fill in your actual values

# Twilio (from twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Groq (from console.groq.com)
GROQ_API_KEY=

# Google Gemini (from aistudio.google.com)
GEMINI_API_KEY=

# Supabase (from supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (from dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# App
BASE_URL=https://citadel-claims.onrender.com
PORTAL_BASE_URL=https://citadel-claims.onrender.com